    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const r = item.json;\n\n  const tidy = value =>\n    String(value ?? '').trim().replace(/\\s+/g, ' ');\n\n  const titleCase = value =>\n    tidy(value)\n      .toLowerCase()\n      .replace(/\\b[a-z]/g, c => c.toUpperCase());\n\n  return {\n    json: {\n      name: titleCase(r.name),\n      email: tidy(r.email).toLowerCase(),\n      course: titleCase(r.course),\n      status: tidy(r.status).toLowerCase(),\n      enrolled_date: tidy(r.enrolled_date)\n    }\n  };\n});"
      },
